    },
    "“%@” was saved to Photos with a print sheet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已连同冲印版存储到“照片”。"
          }
        }
      }
    },
    "“%@” was saved to Photos, and kept in PassPhoto." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已存储到“照片”，并保留在 PassPhoto 中。"
          }
        }
      }
    },
    "“%@” was saved to Photos." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已存储到“照片”。"
          }
        }
      }
    },
    "%@  %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  %2$@"
          }
        }
      }
    },
    "%@ · %lld copies" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$lld 张"
          }
        }
      }
    },
    "%@ · rules as of %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · 规定截至 %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Country and document, e.g. United States Passport",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "%@ %@ · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%2$@ · %3$@"
          }
        }
      }
    },
    "%@ %@; needs %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ %1$@；要求 %3$@。"
          }
        }
      }
    },
    "%@ and isn’t plain: there’s a pattern, texture or something behind you. Needs: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@，且不是纯色：身后有图案、纹理或物体。要求：%2$@。"
          }
        }
      }
    },
    "%@ Check these yourself." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@请自行检查以下项目。"
          }
        }
      }
    },
    "%@ didn’t match its checksum." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的校验和不匹配。"
          }
        }
      }
    },
    "%@ doesn’t allow glasses. Take them off." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不允许戴眼镜，请摘下。"
          }
        }
      }
    },
    "%@ had no usable requirements." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中没有可用的规格。"
          }
        }
      }
    },
    "%@ has separate rules for babies. Turn this on to use them for the instructions, guides and checks." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@对婴儿有单独的规定。打开此选项后，说明、参考线和检查项都会使用婴儿规定。"
          }
        }
      }
    },
    "%@ only accepts photos taken at the office or sent digitally by a certified photographer. A photo you make yourself may be refused." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@只接受在受理点拍摄或由认证摄影师以电子方式提交的照片。自己制作的照片可能会被拒收。"
          }
        }
      }
    },
    "%@ rules changed after this photo was made (now as of %@). Adjust it to check it against the new rules." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制作此照片后，%1$@的规定已更新（现为 %2$@ 版本）。调整照片即可按新规定重新检查。"
          }
        }
      }
    },
    "%@ takes this photo at the office. You don’t need to bring one." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@会在受理点现场拍摄此照片，你无需自带。"
          }
        }
      }
    },
    "%@, print sheet" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，冲印版"
          }
        }
      }
    },
    "%@, with no shadows." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，无阴影。"
          }
        }
      }
    },
    "%@; replaced with %@ as required. Turn off Replace Background to keep the original." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@；已按要求替换为%2$@。关闭“替换背景”即可保留原背景。"
          }
        }
      }
    },
    "%@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。"
          }
        }
      }
    },
    "%@. Needs: %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@。要求：%2$@。"
          }
        }
      }
    },
    "%lld × %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld × %2$@"
          }
        }
      }
    },
    "%lld checks need a look. You can still save, but the photo may be rejected." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 项需要留意。你仍可存储，但照片可能会被拒收。"
          }
        }
      }
    },
    "%lld checks needed a look when saved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储时有 %lld 项需要留意。"
          }
        }
      }
    },
    "%lld faces were found. Only the applicant can be in the photo." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到 %lld 张人脸。照片中只能有申请人本人。"
