    "Make default document" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设为默认证件"
          }
        }
      }
    },
    "Measured on this iPhone. Only cropping and scaling are applied; the photo itself isn’t changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在这台 iPhone 上测量。只进行裁剪和缩放，照片本身不会被修改。"
