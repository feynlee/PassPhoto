    "%lld%% of the frame is past the photo’s edge and will be white. Retake with more space around you, or zoom in." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画框有 %lld%% 超出了照片边缘，这部分将显示为白色。请在周围留出更多空间重拍，或放大照片。"
          }
        }
      }
    },
