    "Saved to Photos" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存储到“照片”"
          }
        }
      }
    },
    "Schengen Area" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "申根区"
          }
        }
      }
    },
    "See all checks" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看全部检查项"
          }
        }
      }
    },
    "Set as Default" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设为默认"
          }
        }
      }
    },
    "Share" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享"
          }
        }
      }
    },
    "Sharp" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清晰"
          }
        }
      }
    },
    "Shows every requirement and whether the photo meets it" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示每项要求及照片是否符合"
          }
        }
      }
    },
    "Shows options for another tip" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示再次打赏的选项"
          }
        }
      }
    },
    "Size" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尺寸"
          }
        }
      }
    },
    "Some values come from the international standard because the issuer doesn’t publish them. Check the official rules before you submit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于签发机构未公布部分数值，这些数值采用国际标准。提交前请查看官方规定。"
          }
        }
      }
    },
    "Someone else, a hand or an object shows in the photo." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片中出现了其他人、手或物体。"
          }
        }
      }
    },
    "Space above head" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头顶上方空间"
          }
        }
      }
    },
    "Specifications" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规格"
          }
        }
      }
    },
    "Stand in front of a plain %@ wall, with nothing behind you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站在%@的纯色墙前，身后不要有任何物体。"
          }
        }
      }
    },
    "Starting the camera…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在启动相机…"
          }
        }
      }
    },
    "Switch Camera" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换相机"
          }
        }
      }
    },
    "Take off your glasses if you can. If you keep them on: no tint and no glare." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尽量摘下眼镜。如果要戴：不能是有色镜片，也不能有反光。"
          }
        }
      }
    },
    "Take off your glasses." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请摘下眼镜。"
          }
        }
      }
    },
    "Take Photo" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照"
          }
        }
      }
    },
    "Tap + to make a passport, visa or ID photo for any of %lld documents. Your photo never goes to a company server, and there’s no account." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 + 即可为 %lld 种证件中的任意一种制作护照、签证或证件照。你的照片不会上传到任何公司的服务器，也无需账户。"
          }
        }
      }
    },
    "Thank you!" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "谢谢你！"
          }
        }
      }
    },
    "Thanks for your support!" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢你的支持！"
          }
        }
      }
    },
    "That photo couldn’t be read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取该照片。"
          }
        }
      }
    },
    "The background can’t be replaced: the person couldn’t be separated from it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法替换背景：无法将人物与背景分离。"
          }
        }
      }
    },
    "The background is replaced only when it doesn’t meet the rules." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在背景不符合规定时才会替换。"
          }
        }
      }
    },
    "The background was replaced." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景已替换。"
          }
        }
      }
    },
    "The expression isn’t neutral. Don’t smile." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表情不够自然，请不要微笑。"
          }
        }
      }
    },
    "The eyes are level." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双眼水平。"
          }
        }
      }
    },
    "The eyes show red-eye. Retake without flash." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出现了红眼。请关闭闪光灯重拍。"
          }
        }
      }
    },
    "The face is %@ left of centre." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脸部偏左 %@。"
          }
        }
      }
    },
    "The face is %@ right of centre." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脸部偏右 %@。"
          }
        }
      }
    },
    "The face is centred." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脸部居中。"
          }
        }
      }
    },
    "The face is too dark or too bright." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脸部太暗或太亮。"
          }
        }
      }
    },
    "The finished photo" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制作好的照片"
          }
        }
      }
    },
    "The head tilts %lld°. Retake with your head straight." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头部倾斜 %lld°。请保持头部端正后重拍。"
          }
        }
      }
    },
    "The model available on this iPhone can’t look at photos." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 上可用的模型无法查看照片。"
          }
        }
      }
    },
    "The mouth is open. Close it and relax your face." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘴巴张开了。请闭上嘴，放松面部。"
          }
        }
      }
    },
    "The original background is kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留原背景。"
          }
        }
      }
    },
    "The original of this photo is missing, so it can’t be adjusted." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此照片的原图已丢失，无法调整。"
          }
        }
      }
    },
    "The photo couldn’t be prepared for review." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备照片以供检查。"
          }
        }
      }
    },
    "The photo couldn’t be rendered." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法渲染照片。"
          }
        }
      }
    },
    "The photo is blurry. Hold still or use a tripod." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片模糊。请保持稳定或使用三脚架。"
          }
        }
      }
    },
    "The photo looks filtered or retouched. Use the original." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片看起来加了滤镜或经过修饰。请使用原图。"
          }
        }
      }
    },
    "The requirements couldn’t be reached." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法获取规定数据。"
          }
        }
      }
    },
    "The saved photo" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存储的照片"
          }
        }
      }
    },
    "The top of the head touches the edge. Zoom out a little." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头顶碰到了边缘。请稍微缩小。"
          }
        }
      }
    },
    "There are shadows on the face. Face a window or add light from the front." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脸上有阴影。请面向窗户，或从正面补光。"
          }
        }
      }
    },
    "There’s glare on the glasses. Tilt them down slightly or take them off." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼镜有反光。请将眼镜稍微向下倾斜或摘下。"
          }
        }
      }
    },
    "These requirements were last confirmed on %@. Check the official page before you submit." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些规定最后确认于 %@。提交前请查看官方页面。"
          }
        }
      }
    },
    "This iPhone doesn’t support Private Cloud Compute." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 不支持私密云计算。"
          }
        }
      }
    },
    "Tinted glasses aren’t allowed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不允许佩戴有色眼镜。"
          }
        }
      }
    },
    "Tip" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打赏"
          }
        }
      }
    },
    "Tip %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打赏 %@"
          }
        }
      }
    },
    "Top of head" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头顶"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试"
          }
        }
      }
    },
    "Turn to face the camera directly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请正对镜头。"
          }
        }
      }
    },
    "Unedited" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未经编辑"
          }
        }
      }
    },
    "Updated to the latest requirements. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已更新为最新规定。"
          }
        }
      }
    },
    "Upload limit" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传大小限制"
          }
        }
      }
    },
    "USCIS (Green Card, Naturalization, EAD)" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USCIS（绿卡、入籍、工作许可）"
          }
        }
      }
    },
    "Visa" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签证"
          }
        }
      }
    },
    "Visas" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签证"
          }
        }
      }
    },
    "Wear everyday clothes in a colour that stands out from the background. No uniforms." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穿与背景颜色有明显区别的日常服装。不要穿制服。"
          }
        }
      }
    },
    "white" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白色"
          }
        }
      }
    },
    "white or off-white" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "白色或米白色"
          }
        }
      }
    },
    "You have the latest requirements. " : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的规定已是最新版本。"
          }
        }
      }
    },
    "You’re Welcome" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不客气"
          }
        }
      }
    },
    "You’ve given %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已打赏 %@"
          }
        }
      }
    },
    "You’ve given %@ so far." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你目前已打赏 %@。"
          }
        }
      }
    },
    "Your background" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的背景"
          }
        }
      }
    },
    "Your background didn’t meet the rules, so it was replaced. The person isn’t changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的背景不符合规定，因此已被替换。人物本身未做改动。"
          }
        }
      }
    },
    "Your background is %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的背景为%@"
          }
        }
      }
    },
    "Your coffee means a lot. As a thank-you, every photo you save now comes with a little celebration." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的咖啡对我意义重大。作为感谢，你今后每次存储照片都会有一个小小的庆祝动画。"
          }
        }
      }
    },
    "Your shadow shows on the background. Step away from the wall." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景上有你的影子。请离墙远一些。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}